# Vibe-Voice Backend Environment Configuration
# Copy this file to .env and adjust values as needed

# Application environment (development | production)
NODE_ENV=development

# Server port (default: 3001)
# Cloud platforms (Render, Railway) set PORT automatically
PORT=3001

# Server host (default: localhost)
# Use 0.0.0.0 for cloud deployment to accept all interfaces
HOST=localhost

# Allowed CORS origin for frontend (default: http://localhost:5173 for Vite dev server)
# For Electron app, use: file:// or app://your-app-name
# For production, use your actual domain: https://your-domain.com
CORS_ORIGIN=http://localhost:5173

# Maximum number of users per room (default: 4)
MAX_ROOM_SIZE=4

# ============================================================
# PRODUCTION DEPLOYMENT NOTES
# ============================================================
# 
# Render.com:
#   - PORT is set automatically by Render
#   - Set HOST=0.0.0.0 in environment variables
#   - Set CORS_ORIGIN to your frontend domain
#   - Example: CORS_ORIGIN=https://vibe-voice.onrender.com
#
# Railway:
#   - PORT is set automatically by Railway
#   - Set HOST=0.0.0.0 in environment variables
#   - Set CORS_ORIGIN to your frontend domain
#
# Electron Desktop App:
#   - For development: CORS_ORIGIN=http://localhost:5173
#   - For production: CORS_ORIGIN=app://vibe-voice or file://
#   - Or use wildcard for Electron: CORS_ORIGIN=*
#
# Cloud Deployment Checklist:
#   ✓ NODE_ENV=production
#   ✓ HOST=0.0.0.0
#   ✓ CORS_ORIGIN=https://your-frontend-domain.com
#   ✓ PORT (auto-set by platform)
#   ✓ MAX_ROOM_SIZE=4 (or adjust as needed)
# ============================================================
