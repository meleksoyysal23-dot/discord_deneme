{
  "name": "voicecan",
  "productName": "VoiceCan",
  "private": true,
  "version": "2.1.3",
  "description": "VoiceCan - Sesli Sohbet ve Topluluk Platformu",
  "main": "electron/main.cjs",
  "author": "Mehmetcan Bayatlı",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:bypass": "vite --mode bypass",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "dist": "npm run build && electron-builder --win",
    "dist:portable": "npm run build && electron-builder --win portable",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release.ps1",
    "build:publish": "electron-builder --win --publish always"
  },
  "dependencies": {
    "@livekit/components-react": "^2.9.24",
    "electron-updater": "^6.8.11",
    "livekit-client": "^2.23.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "concurrently": "^10.0.6",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.89.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.mehmetcanbayatli.voicecan",
    "productName": "VoiceCan",
    "copyright": "Copyright © 2026 Mehmetcan Bayatlı",
    "directories": {
      "output": "dist-exe-v11"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "artifactName": "VoiceCan-Setup-${version}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "meleksoyysal23-dot",
      "repo": "discord_deneme",
      "releaseType": "release"
    }
  }
}
